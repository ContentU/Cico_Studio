
# Form Contatti via Brevo (email transazionale). Solo su Netlify, mai su GitHub.
# CONTACT_FROM_EMAIL=hello@cicostudio.it   # mittente VERIFICATO in Brevo
# CONTACT_TO_EMAIL=hello@cicostudio.it     # destinatario (default hello@cicostudio.it)
# usa anche BREVO_API_KEY della newsletter

# Form Contatti via SMTP (casella Aruba) - consigliato. Solo su Netlify, mai su GitHub.
# SMTP_USER=hello@cicostudio.it      # indirizzo completo della casella
# SMTP_PASS=********                 # password della casella (solo su Netlify)
# SMTP_HOST=smtps.aruba.it           # default
# SMTP_PORT=465                      # default (SSL)
# CONTACT_TO_EMAIL=hello@cicostudio.it   # destinatario (default = SMTP_USER)
